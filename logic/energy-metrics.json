 {
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "triggers": {
    "When_an_HTTP_request_is_received": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "properties": {
            "appliance": { "type": "string" },
            "time_minutes": { "type": "integer" },
            "power_setting": { "type": "string" }
          }
        }
      }
    }
  },
  "actions": {
    "Initialize_variables": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          { "name": "tariff", "type": "float", "value": 0.03 }
        ]
      },
      "runAfter": {}
    },
    "Condition": {
      "type": "If",
      "expression": {
        "or": [
          { "equals": [ "@empty(triggerBody()?['appliance'])", true ] },
          { "less": [ "@coalesce(triggerBody()?['time_minutes'], 0)", 1 ] }
        ]
      },
      "actions": {
        "Response_400": {
          "type": "Response",
          "kind": "Http",
          "inputs": {
            "statusCode": 400,
            "headers": { "Content-Type": "application/json" },
            "body": { "error": "appliance is required and time_minutes must be at least 1" }
          }
        }
      },
      "else": {
        "actions": {
          "Switch": {
            "type": "Switch",
            "expression": "@triggerBody()?['appliance']",
            "cases": {
              "stove": {
                "case": "stove",
                "actions": {
                  "Set_variable": {
                    "type": "SetVariable",
                    "inputs": { "name": "tariff", "value": 0.03 }
                  }
                }
              },
              "oven": {
                "case": "oven",
                "actions": {
                  "Set_variable_1": {
                    "type": "SetVariable",
                    "inputs": { "name": "tariff", "value": 0.05 }
                  }
                }
              },
              "microwave": {
                "case": "microwave",
                "actions": {
                  "Set_variable_2": {
                    "type": "SetVariable",
                    "inputs": { "name": "tariff", "value": 0.02 }
                  }
                }
              },
              "airfryer": {
                "case": "airfryer",
                "actions": {
                  "Set_variable_3": {
                    "type": "SetVariable",
                    "inputs": { "name": "tariff", "value": 0.025 }
                  }
                }
              }
            },
            "default": {
              "actions": {
                "Set_variable_4": {
                  "type": "SetVariable",
                  "inputs": { "name": "tariff", "value": 0.03 }
                }
              }
            }
          },
          "Compose_kwh": {
            "type": "Compose",
            "inputs": "@float(formatNumber(mul(mul(variables('tariff'), triggerBody()?['time_minutes']), if(equals(triggerBody()?['power_setting'], 'low'), 0.7, if(equals(triggerBody()?['power_setting'], 'high'), 1.4, 1.0))), '0.00', 'en-US'))",
            "runAfter": { "Switch": [ "Succeeded" ] }
          },
          "Compose_result": {
            "type": "Compose",
            "inputs": {
              "estimated_kwh": "@outputs('Compose_kwh')",
              "co2_impact_grams": "@float(formatNumber(mul(outputs('Compose_kwh'), 400), '0.0', 'en-US'))",
              "energy_efficiency_label": "@if(less(outputs('Compose_kwh'), 0.3), 'A', if(less(outputs('Compose_kwh'), 0.6), 'B', if(less(outputs('Compose_kwh'), 1.0), 'C', if(less(outputs('Compose_kwh'), 1.5), 'D', 'E'))))",
              "estimated_cost_eur": "@float(formatNumber(mul(outputs('Compose_kwh'), 0.3), '0.00', 'en-US'))"
            },
            "runAfter": { "Compose_kwh": [ "Succeeded" ] }
          },
          "HTTP": {
            "type": "Http",
            "inputs": {
              "uri": "https://soap.invalid/",
              "method": "POST",
              "headers": { "Content-Type": "application/json" },
              "body": { "ping": "energy" },
              "retryPolicy": { "type": "none" }
            },
            "runAfter": { "Compose_result": [ "Succeeded" ] }
          },
          "Response_200": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 200,
              "headers": { "Content-Type": "application/json" },
              "body": "@outputs('Compose_result')"
            },
            "runAfter": { "HTTP": [ "Succeeded", "Failed", "TimedOut" ] }
          }
        }
      },
      "runAfter": { "Initialize_variables": [ "Succeeded" ] }
    }
  },
  "outputs": {},
  "parameters": {}
}